  "criteria": [
    {
      "id": "provenance-correction.working.q.geometry",
      "name": "geometry",
      "check": "Decode the delivered PNG as exactly 64x16: four horizontal 16x16 cells at x=0,16,32,48 with no gutters or added canvas between or around the cells (transparent margin inside a cell is composition, not padding). Basis: src/queue-view-successor.ts declares running frames 4, display.cell [16,16] and frameMs 100; the supplied renderer fixture renderer-successor/view.mjs draws only when width == 16*frames and height == 16, slices frame*16,0,16,16 and, under no-preference only, advances floor(elapsed/100) mod 4 (nominal 400 ms cycle). Under reduced motion it selects frame zero without changing the four-cell sheet geometry.",
      "domain": "mechanical",
      "mode": "local",
      "status": "unperformed",
      "verdict": null
    },
    {
      "id": "provenance-correction.working.q.transparent-exterior.diagnostic",
      "name": "transparent-exterior.diagnostic",
      "check": "Retain per-cell alpha histogram and nonzero-alpha component boxes. Flag a component touching all four edges or covering more than half the cell for visual review only. No flag value is an acceptance/rejection threshold; a full-span glyph or deliberate backing can be valid. Alpha-zero RGB is insignificant.",
      "domain": "mechanical",
      "mode": "local",
      "status": "unperformed",
      "verdict": null
    },
    {
