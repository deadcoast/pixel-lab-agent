@k.rig-sockets:K{ap=[interchangeable_limbs_f0ef7c84,weapons_167a79b5,modular_bosses_2efd9031];ck=[~83:Every valid swap preserves the socket world position within the declared tolerance.,~58:Unknown sockets or incompatible part tags fail explicitly.];nm=~53:Define pivot and socket coordinates in logical pixels;op=[~73:Store socket and pivot values in the same explicit coordinate convention.,~83:Position the child so its transformed pivot equals the parent's transformed socket.,~55:Recalculate attachment pivots when trim offsets change.];pc=[@e.rig-sockets];rk=[~121:Integer-valued pivots are not universally correct; even-size centers may be half-integer under a pixel-center convention.,~59:Mirroring may require semantic left/right socket remapping.];rq=[~91:Coordinate origin, pixel-center or pixel-corner convention, parent sockets and child pivots];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@s6f9fa2b06515984fcc7d,@s82606b0dda9bdf34a685];tg=[~11:rig-sockets]}
@k.rotation-policy:K{ap=[aiming_weapons_9f6c4633,rotating_machinery_23088087,directional_actors_ab994558];ck=[~47:All rendered angles follow the chosen strategy.,~81:Every required orientation is covered, and pixel crawl is reviewed where allowed.];nm=~40:Choose a rotation strategy for each part;op=[~109:Choose continuous nearest sampling, quantized angles, hand-drawn directions or an intermediate render target.,~45:Document which visual changes are acceptable.,~64:Evaluate extreme and intermediate poses around the actual pivot.];pc=[@e.rotation-policy];rk=[~77:Nearest sampling and a snapped pivot do not make arbitrary rotation lossless.,~85:A 90-degree rotation can preserve texels while changing directional lighting meaning.];rq=[~62:Permitted angles, silhouette tolerance and target logical grid];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@s421ed849e57486e9efee,@s3588e7168ca94eade6be];tg=[~15:rotation-policy]}
@k.selective-edge-aa:K{ap=[subpixel_edges_cb6d504d,curves_against_known_backgrounds_6fcf945e];ck=[~62:Changed pixels stay within the selected edge mask and palette.,~43:Protected hard edges remain byte-identical.];nm=~55:Apply authored edge antialiasing only to selected edges;op=[~86:Choose intermediate colors from the approved ramp inside the selected boundary region.,~80:Preserve required hard edges and avoid universal outlines of intermediate color.,~57:Preview against each allowed background before accepting.];pc=[@e.selective-edge-aa];rk=[~80:Background-specific intermediate colors can form halos on different backgrounds.,~88:This is authored color placement, not a permission to enable bilinear texture filtering.];rq=[~59:Approved edge ramp, edge mask and representative background];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@s13506aa304092b45e0b3,@s54972c78922906eca1d4];tg=[~17:selective-edge-aa]}
@k.semantic-clusters:K{ap=[sprite_cleanup_d4949c19,protected_eyes_3d8487f0,material_boundaries_234882e3,micro_animation_7168ed12];ck=[~44:Connected-component counts are reproducible.,~56:Protected feature masks remain present after operations.];nm=~58:Track raster connectivity and semantic clusters separately;op=[~63:Extract same-color connected components with the selected rule.,~88:Label intentional details such as eyes, sparks and stars; these may be legal singletons.,~82:Use semantic masks across multiple colors when a feature must be edited as a unit.];pc=[@e.semantic-clusters];rk=[~66:A semantic cluster need not be a single-color connected component.,~66:Automatically deleting every singleton destroys legitimate detail.];rq=[~51:A declared 4- or 8-neighbor rule and semantic masks];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@s652a2625a4c03c5393f0,@s91009133fa6defac6c1c];tg=[~17:semantic-clusters]}
@k.shading-drift:K{ap=[breathing_idles_9072d861,slow_turns_3e231f6f,cloth_or_muscle_motion_9df2c401];ck=[~58:Protected silhouette and identity pixels remain unchanged.,~57:All changed pixels belong to the declared shading region.];nm=~52:Animate internal shading while protecting silhouette;op=[~77:Keep the outer occupancy stable for a subtle idle when the brief requires it.,~51:Shift only selected internal highlights or shadows.,~94:Review whether shading motion communicates form or incorrectly looks like moving illumination.];pc=[@e.shading-drift];rk=[~68:Highlight movement may imply changing light rather than body motion.,~81:Silhouette preservation is a local idle constraint, not a general animation rule.];rq=[~65:Opaque mask, semantic highlight or shadow mask and approved ramps];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sfb90c9a5cf58bf9ab045,@sd2842ec93cd5ec691f7b];tg=[~13:shading-drift]}
@k.shadow-visibility:K{ap=[shadow_casting_props_6e4cf652,walls_5fbffcac,dynamic_lights_58368a72];ck=[~61:A normal-only asset cannot satisfy a shadow-casting contract.,~89:Removing the occluder changes visibility while leaving surface normal response unchanged.];nm=~40:Separate surface response from occlusion;op=[~54:Evaluate orientation and visibility as separate terms.,~83:Require an actual visibility representation when the asset declares shadow casting.,~81:Choose caster simplification and light-resolution policy appropriate to the game.];pc=[@e.shadow-visibility];rk=[~62:A dark diffuse patch is not evidence of a dynamic cast shadow.,~62:Normal maps do not encode which other object blocks the light.];rq=[~85:An explicit caster polygon, occupancy field, depth or other visibility representation];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@scde3e8a0ce9110fedef4,@sfea1532bec9c70f9e451];tg=[~17:shadow-visibility]}
@k.sheet-metadata:K{ap=[spritesheets_16aafbd4,tilesets_85cbc0d7,atlas_import_95f7d6a2];ck=[~49:Each referenced frame is present and addressable.,~60:Round-trip extraction preserves expected pixels and anchors.];nm=~45:Make sheet layout and frame identity explicit;op=[~53:Store frame rectangles and stable IDs with the sheet.,~80:Validate in-bounds rectangles, intended overlaps, frame order and trim metadata.,~85:Extract frames and reconstruct the logical originals before using a sheet in runtime.];pc=[@e.sheet-metadata];rk=[~73:A PNG sheet alone does not communicate playback duration, pivots or tags.,~60:Packed atlas order can differ from semantic animation order.];rq=[~72:Image dimensions, frame rectangles, offset, spacing, margin and ordering];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sd0675d9c7db2d15689ca,@sd27897a353e28c7d496d];tg=[~14:sheet-metadata]}
@k.silhouette-readability:K{ap=[characters_25d939ff,inventory_icons_f7812ea4,interactive_props_25a44283];ck=[~59:Named identity landmarks remain visible at the target size.,~79:Required gaps stay open and interactive forms separate from their surroundings.];nm=~57:Evaluate identity using silhouette and target backgrounds;op=[~43:Render a flat opaque mask before detailing.,~91:Inspect major proportions, negative spaces and landmark separation at native logical scale.,~77:Compare the colored asset on representative light, dark and busy backgrounds.];pc=[@e.silhouette-readability];rk=[~66:Silhouette alone cannot validate faces, materials or fine symbols.,~62:No contrast ratio or component count proves aesthetic quality.];rq=[~73:Intended viewing scale, representative backgrounds and identity landmarks];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@s91009133fa6defac6c1c,@sd2842ec93cd5ec691f7b,@s2fbbfc61e7b755afc530];tg=[~22:silhouette-readability]}
@k.state-driven-pixel-ui:K{ap=[pixel_interaction_prompts_020831fc,health_icons_2ef86a03,selected_project_ui_80730ea8];ck=[~67:The visual state corresponds to the supplied input or health state.,~71:No decorative timer reports an event or progress that has not occurred.];nm=~48:Tie pixel UI animation to actual state and input;op=[~72:Map idle, pressed, disabled and health states to explicit visual states.,~60:Use timing only for the transition the real event triggered.,~82:Retain static recognizability and adapt scale and color across the surrounding UI.];pc=[@e.state-driven-pixel-ui];rk=[~88:The archive's keyboard prompt and Waylight palette rules belong to its original project.,~88:A CSS demo with blur or continuous motion may conflict with a strict-grid asset profile.];rq=[~72:Authoritative input or gameplay state and project-specific styling brief];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sa1c6a02f86655384b7b8,@s2a23b0f0a71cec03dd69,@sa6f70d62df08c3cb0960];tg=[~21:state-driven-pixel-ui]}
@k.terrain-topology:K{ap=[roads_846bb37c,fences_d5624936,terrain_transitions_b20ad89c,autotiles_ca299e44];ck=[~79:Every declared pattern resolves or produces an explicit missing-pattern result.,~72:Adjacent edge or corner labels agree according to the selected topology.];nm=~50:Choose and exhaustively exercise tile connectivity;op=[~71:Define the bit ordering and which neighbor relations a tile represents.,~63:Enumerate the supported patterns and any intentional omissions.,~97:Verify selected tiles satisfy the neighborhood labels instead of guessing topology from an image.];pc=[@e.terrain-topology];rk=[~87:A 16-tile edge set, 16-tile corner set and 47-tile blob set encode different contracts.,~59:Do not assume every tile generator emits the same ordering.];rq=[~64:Named terrain labels and explicit edge, corner or mixed topology];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sf0690061eaa2c48ba000,@seacd8dde28a76b901830];tg=[~16:terrain-topology]}
@k.tile-repeat:K{ap=[seamless_textures_c8b9aaa4,floors_1d01b346,walls_5fbffcac,background_fills_b13f6457];ck=[~33:The declared edge relation holds.,~71:A native-scale neighborhood review checks visible seams and repetition.];nm=~40:Test repeating texture in a neighborhood;op=[~56:Design features that continue across wrapped boundaries.,~61:Render a 3x3 repetition and mark dominant repeated landmarks.,~124:For exact-match edge contracts compare opposite edge samples; for transition art inspect the declared continuation relation.];pc=[@e.tile-repeat];rk=[~83:Matching edge bytes is neither necessary nor sufficient for every seamless texture.,~61:Random interior noise does not automatically hide repetition.];rq=[~58:Tile dimensions and a declared edge-compatibility contract];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sf2182067b746c1a96c82,@s871969227f213f07a075,@s60edbd1893a20236581b];tg=[~11:tile-repeat]}
@k.tile-variants:K{ap=[repeated_terrain_1dfb8c05,biome_variants_6c1a9dfe,decorative_tile_reuse_cd70b901];ck=[~62:Variant selection never changes the required connection class.,~89:Same seed and inputs select the same sequence when deterministic generation is requested.];nm=~57:Vary interiors while preserving connectivity and lighting;op=[~46:Group variants by identical connection labels.,~77:Change interior details while keeping necessary boundary features compatible.,~88:Permit flips or rotations only when directional lighting and world meaning remain valid.];pc=[@e.tile-variants];rk=[~56:Mirroring a shaded wall can reverse its light direction.,~92:Variant weights describe selection policy, not a guarantee of visual variety in a small map.];rq=[~68:A base topology, allowed transformations and seeded selection policy];so=[@s9607720391d7364f4ce0,@s0d4c84c1f64ae48044b9,@sbecd5d040a6c73c7d34f,@sf2182067b746c1a96c82,@s2a624767ca7bea20d26c,@s638e7446095944146494];tg=[~13:tile-variants]}
