{
  "create_image_pro_flash": {
    "type": "object",
    "properties": {
      "description": {
        "type": "string",
        "minLength": 1
      },
      "width": {
        "type": "integer",
        "minimum": 16,
        "maximum": 256,
        "multipleOf": 4
      },
      "height": {
        "type": "integer",
        "minimum": 16,
        "maximum": 256,
        "multipleOf": 4
      },
      "no_background": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "description"
    ],
    "additionalProperties": false
  },
  "list_jobs": {
    "type": "object",
    "properties": {
      "include_recent": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "get_image": {
    "type": "object",
    "properties": {
      "job_id": {
        "type": "string"
      },
      "index": {
        "type": [
          "integer",
          "null"
        ]
      }
    },
    "required": [
      "job_id"
    ],
    "additionalProperties": false
  }
}
