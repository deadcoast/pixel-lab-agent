            "description": "Outline style reference (weakly guiding)"
          },
          "shading": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Shading"
              },
              {
                "type": "null"
              }
            ],
            "description": "Shading style reference (weakly guiding)"
